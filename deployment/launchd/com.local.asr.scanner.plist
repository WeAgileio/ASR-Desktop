<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.local.asr.scanner</string>
<key>ProgramArguments</key><array>
<string>/ABSOLUTE/ASR/.venv-worker/bin/python</string>
<string>/ABSOLUTE/ASR/deployment/run_host.py</string>
<string>scanner</string><string>/ABSOLUTE/LOCAL/host.json</string>
</array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string><key>PYTHONPATH</key><string>/ABSOLUTE/ASR/src</string></dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
