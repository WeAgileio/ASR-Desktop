# Store the real env file outside this repository and iCloud; chmod 600.
ASR_ADMIN_PASSWORD=REPLACE_WITH_32_RANDOM_CHARACTERS
ASR_WORKER_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN
ASR_SIGNING_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_KEY
ASR_DASHBOARD_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PASSWORD
ASR_WEB_PORT=8090
ASR_REDIS_PORT=16379
ASR_DASHBOARD_PORT=9181

# Required only for compose.ghcr.yaml; use the lowercase GitHub owner/repository.
# Prefer a published sha-<full commit SHA> tag or @sha256:<digest>.
# ASR_IMAGE=ghcr.io/owner/repository:latest
